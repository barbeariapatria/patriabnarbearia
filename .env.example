# Porta do servidor
PORT=3000
# Fuso horário usado para calcular o "dia de apuração"
TZ=America/Sao_Paulo
# Único login do painel (criado na primeira execução). Sem ADMIN_PASSWORD, uma senha temporária aparece no log.
ADMIN_USER=barbeariapatria@gmail.com
ADMIN_PASSWORD=
# true = permite cadastrar outros usuários no painel (padrão: só o login acima)
MULTI_USER=false
# Segredo para assinar a sessão (gere algo longo e aleatório)
SESSION_SECRET=
# Duração da sessão em horas
SESSION_HOURS=12
# Defina true quando estiver atrás de HTTPS
COOKIE_SECURE=false
# URL pública (usada para mostrar a URL do webhook no painel), ex.: https://painel.suabarbearia.com.br
PUBLIC_URL=
# Banco na nuvem (obrigatório na Vercel): Supabase via POSTGRES_URL, ou Turso via TURSO_DATABASE_URL + TURSO_AUTH_TOKEN.
# Sem nenhum deles, usa um arquivo SQLite em DATA_DIR
POSTGRES_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATA_DIR=./data
# Fuso usado para o "dia de apuração" (a Vercel roda em UTC)
APP_TZ=America/Sao_Paulo

{
  "name": "dashboard-barbearia",
  "version": "1.0.0",
  "description": "Dashboard de metas, faturamento e profissionais — integração CashBarber via webhook",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "build": "node scripts/copy-vendor.js && tsc -p web/tsconfig.json && vite build -c web/vite.config.mts",
    "dev:web": "vite build -c web/vite.config.mts --watch"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@libsql/client": "0.17.3",
    "chart.js": "4.4.7",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
